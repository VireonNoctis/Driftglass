{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driftglass run manifest v1",
  "description": "Identity, environment, capture status, and collection coverage for one run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "role",
    "application",
    "environment",
    "capture",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"type": "string", "enum": ["baseline", "candidate"]},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ],
          "description": "SHA-256 of the exact artifact, or null when unavailable."
        },
        "package_id": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture", "snapshot_id"],
      "properties": {
        "os": {"type": "string", "minLength": 1, "maxLength": 64},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
        "snapshot_id": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "ended_at", "scenario", "profile"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["running", "completed", "incomplete", "failed"]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "scenario": {"type": "string", "minLength": 1, "maxLength": 1024},
        "profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "status_reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_sources",
        "unavailable_categories",
        "dropped_events",
        "errors"
      ],
      "properties": {
        "event_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "state", "categories"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "state": {
                "type": "string",
                "enum": ["active", "inactive", "failed", "unavailable", "not_configured"]
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["process", "network", "file", "system", "persistence"]
                },
                "uniqueItems": true
              }
            }
          }
        },
        "unavailable_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["process", "network", "file", "system", "persistence"]
          }
        },
        "dropped_events": {"type": "integer", "minimum": 0},
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4096,
      "description": "Optional user notes; may contain sensitive information."
    }
  }
}
