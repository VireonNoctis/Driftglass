{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftglass.local/schemas/reports/export-manifest-v1.schema.json",
  "title": "Driftglass comparison report export integrity manifest v1",
  "description": "Detached SHA-256 integrity data; not a signature or proof of report origin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_sha256", "artifact_size_bytes", "report_id"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "driftglass-comparison-report"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
