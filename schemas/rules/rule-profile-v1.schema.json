{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftglass.local/schemas/rules/rule-profile-v1.schema.json",
  "title": "Driftglass comparison rule profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "included_categories",
    "ignored_attributes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "included_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "process",
          "network",
          "file",
          "system"
        ]
      }
    },
    "ignored_attributes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      }
    }
  }
}
